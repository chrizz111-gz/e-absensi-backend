# =============================================================================
# E-Absensi Backend - Contoh Environment
# Salin menjadi .env lalu isi nilainya. JANGAN commit file .env asli.
# =============================================================================

# App
APP_ENV=development
APP_PORT=8080

# Database (PostgreSQL)
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=absensi
DB_SSLMODE=disable

# JWT
JWT_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Google Sign-In (dari Google Cloud Console)
GOOGLE_CLIENT_ID=

# Email OTP via SMTP / Mailtrap
# Kosongkan SMTP_HOST untuk mode dev: OTP di-log ke konsol.
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM=E-Absensi <no-reply@e-absensi.local>

# Rate limit per-IP untuk endpoint auth (0 = nonaktif)
RATE_LIMIT_RPS=5
RATE_LIMIT_BURST=10

# CORS: daftar origin web yang diizinkan (dipisah koma). Kosong = default dev
# (React CRA :3000 & Vite :5173). Contoh production:
# CORS_ALLOWED_ORIGINS=https://absensi.sekolah.sch.id,https://admin.absensi.sekolah.sch.id
CORS_ALLOWED_ORIGINS=
