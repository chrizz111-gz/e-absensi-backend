# =============================================================================
# E-Absensi Backend - Contoh Environment (SIAP PAKAI)
# 1) Salin menjadi .env
# 2) Jalankan scripts/gen-secrets.ps1 untuk mengisi JWT_SECRET & JWT_REFRESH_SECRET
# File .env asli TIDAK ikut ke Git (lihat .gitignore). JANGAN commit file .env.
# =============================================================================

# App
APP_ENV=development
APP_PORT=8080

# Database (PostgreSQL) - dev only, jangan dipakai di server
DB_USER=TAabsensi
DB_PASSWORD=rpl1buatabsensi
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=absensi
DB_SSLMODE=disable

# JWT - placeholder. Jalankan scripts/gen-secrets.ps1 untuk mengisi nilai acak.
# (Secret asli sengaja tidak ditulis di repo karena repo bersifat publik.)
JWT_SECRET=__GENERATE__
JWT_REFRESH_SECRET=__GENERATE__
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Google Sign-In (dari Google Cloud Console)
GOOGLE_CLIENT_ID=

# Email OTP via SMTP / Mailtrap
# Kosongkan SMTP_HOST untuk mode dev: OTP di-log ke konsol.
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM=E-Absensi <no-reply@e-absensi.local>

# Rate limit per-IP untuk endpoint auth (0 = nonaktif)
RATE_LIMIT_RPS=5
RATE_LIMIT_BURST=10

# CORS: daftar origin web yang diizinkan (dipisah koma). Kosong = default dev
# (React CRA :3000 & Vite :5173). Contoh production:
# CORS_ALLOWED_ORIGINS=https://absensi.sekolah.sch.id,https://admin.absensi.sekolah.sch.id
CORS_ALLOWED_ORIGINS=
